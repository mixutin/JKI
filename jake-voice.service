# Prefer `jki install-desktop`, which records the actual Python/config paths.
[Unit]
Description=JKI (Jake Voice) local speech companion
After=graphical-session.target pipewire.service
PartOf=graphical-session.target

[Service]
Type=simple
UMask=0077
NoNewPrivileges=yes
ExecStart=%h/.local/share/jake-voice/venv/bin/python -m jki run
Restart=on-failure
RestartSec=5
TimeoutStopSec=15

[Install]
WantedBy=graphical-session.target
